build/
out/
CMakeUserPresets.json
.cache/

# Reverse-engineering scratch: extracted vendor material, decrypted config dumps.
# Never commit these (vendor code, and the config dump held account tokens).
.re/

# Vendor logs may contain credentials — never commit them.
*.log

